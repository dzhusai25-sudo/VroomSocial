{
  "name": "wroomsocial",
  "version": "1.0.0",
  "private": "true",
  "scripts": {
    "test": "jest",
    "lint": "eslint",
    "prepare": "husky",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "dev": "vite",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "deploy": "npm run build && gh-pages -d dist",
